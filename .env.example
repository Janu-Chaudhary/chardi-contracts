# Copy this file to .env and fill in your values
# Never commit .env to git

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SAM.gov public API key — register at https://api.sam.gov
SAM_GOV_API_KEY=SAM-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional — defaults shown
SAM_GOV_BASE_URL=https://api.sam.gov/prod/opportunities/v2/search
USER_AGENT=YourName-ChardiAI-Trial/1.0
REQUEST_TIMEOUT_SECONDS=60
